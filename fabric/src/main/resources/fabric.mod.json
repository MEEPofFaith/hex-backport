{
  "schemaVersion": 1,
  "id": "hexbackport",
  "version": "${version}",
  "name": "HexBackport",
  "description": "Backports stuff from the 1.21 version of Hex Casting",
  "authors": [
    "MEEPofFaith"
  ],
  "contact": {
    "homepage": "https://meepoffaith.github.io/hex-backport",
    "sources": "https://github.com/MEEPofFaith/hex-backport"
  },
  "license": "MIT",
  "icon": "assets/hexbackport/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [{
      "adapter": "kotlin",
      "value": "com.meepoffaith.hexbackport.fabric.FabricHexbackport"
    }],
    "client": [{
      "adapter": "kotlin",
      "value": "com.meepoffaith.hexbackport.fabric.FabricHexbackportClient"
    }],
    "server": [{
      "adapter": "kotlin",
      "value": "com.meepoffaith.hexbackport.fabric.FabricHexbackportServer"
    }],
    "fabric-datagen": [{
      "adapter": "kotlin",
      "value": "com.meepoffaith.hexbackport.fabric.datagen.FabricHexbackportDatagen"
    }],
    "modmenu": [{
      "adapter": "kotlin",
      "value": "com.meepoffaith.hexbackport.fabric.FabricHexbackportModMenu"
    }]
  },
  "mixins": [
    "hexbackport-common.mixins.json",
    "hexbackport-fabric.mixins.json"
  ],
  "depends": {
    "minecraft": "${versions.minecraft}",
    "fabricloader": ">=${versions.fabric_loader}",
    "fabric-api": ">=${versions.fabric_api}",
    "fabric-language-kotlin": ">=${versions.kotlin_fabric}",
    "architectury": ">=${versions.architectury}",
    "hexcasting": ">=${versions.hexcasting}",
    "cloth-config": ">=${versions.clothConfig}"
  },
  "suggests": {
    "modmenu": ">=${versions.modMenu}"
  }
}
